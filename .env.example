ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Per-ticket: fetch threads+comments+history in parallel (default on). Set 0 to disable.
ZOHO_PARALLEL_FETCH=1
# Background sync interval (minutes). Higher = fewer Zoho API calls per day. Min 15, max 1440.
ZOHO_SYNC_INTERVAL_MINUTES=30
# Reporting timezone (IANA). Default US Pacific (PST/PDT). Metabase views v_reporting_*_pt use this.
ANALYTICS_REPORT_TIMEZONE=America/Los_Angeles
# Comma-separated agents to hide from analytics (raw rows still stored). Name and/or id.
ANALYTICS_EXCLUDED_AGENT_NAMES=TechProduct Team
ANALYTICS_EXCLUDED_AGENT_IDS=7296000004702077
SYNC_LOOKBACK_DAYS=31
# Overlap with last sync; lower = slightly fewer duplicate ticket fetches (default 24 is safe).
SYNC_OVERLAP_HOURS=24
DATABASE_URL=postgresql://postgres:postgres@db:5432/zoho_analytics

# --- Telegram bot (optional) ---
# Bot token from @BotFather (format 123456789:ABC-DEF...). Leave blank to disable the bot.
TELEGRAM_BOT_TOKEN=
# Zoho agent the bot watches (default = Kasra / Kas M). Override only if monitoring someone else.
TELEGRAM_AGENT_ID=7296000000961828
TELEGRAM_AGENT_NAME=Kas M
# Timezone for displayed times in Telegram messages.
TELEGRAM_TIMEZONE=America/Los_Angeles
# A ticket is "stale" after this many hours without an agent reply.
TELEGRAM_STALE_HOURS=8
# Don't repeat the same alert (same type+ticket) within this many hours.
TELEGRAM_ALERT_DEDUP_HOURS=12
# How often the bot scans Zoho for critical/stale tickets and callback promises.
TELEGRAM_SCAN_INTERVAL_MINUTES=5
# How often the bot drains incoming /commands.
TELEGRAM_POLL_INTERVAL_SECONDS=10
